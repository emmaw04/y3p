        "vse_compound_ann": {
          "kind": "keras",
          "preprocessor": "vse_compound_ann_preprocessor.joblib",
          "model": "vse_compound_ann_model.keras",
          "spec": "vse_compound_ann_spec.json"
        }
      }
    }
  }
}