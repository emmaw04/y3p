      "p_ann_c3",
      "p_ann_c4",
      "p_vse_compound_ann_c0",
      "p_vse_compound_ann_c1",
      "p_vse_compound_ann_c2",
      "p_vse_compound_ann_c3",
      "p_vse_compound_ann_c4",
      "race_progress",
      "pit_stops_so_far",
      "current_compound",
      "race_track",
      "fulfilled_second_compound",
      "rained_yet",
      "is_raining",
      "minutes_rain",
      "row_id"
    ],
    "classes": [
      "HARD",
      "MEDIUM",
      "SOFT",
      "INTERMEDIATE",
      "WET"
    ],
    "artifacts": {
      "meta_pipeline": "meta_pipeline.joblib",
      "meta_features": "meta_features.json",
      "feature_columns": "feature_columns.json",
      "classes": "classes.json",
      "base_pipelines": {
        "svm": "base_svm_pipeline.joblib",
