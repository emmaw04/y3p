{
  "run_name": "feb04",
  "seed": 42,
  "n_splits": 5,
  "holdout_race_ids": [
    53,
    73,
    24,
    75,
    2
  ],
  "datasets": {
    "stage1_path": "output1_ergast.csv",
    "stage2_path": "output2_ergast.csv",
    "note": "Loaders excluded holdout races at load time; final models are trained on non-holdout races only."
  },
  "model_config": {
    "random_state": 42,
    "n_jobs": -1,
    "use_class_weight": false
  },
  "stage1_binary": {
    "stage": "stage1_binary",
    "base_models": [
      "svm",
      "rf",
      "xgb",
      "ann"
    ],
    "meta_model": "xgb",
    "X_columns": [
      "lapno",
      "race_progress",
      "position",
      "fcy_status",
      "pit_stops_so_far",
      "tyre_change_pursuer",
      "track_category",
      "current_compound",
      "lap_time",
      "interval",
      "tyre_age",
      "close_ahead",
      "race_track",
      "rained_yet",
      "is_raining",
      "minutes_rain",
      "fulfilled_second_compound",
      "row_id"
    ],
    "meta_feature_columns": [
      "p_svm",
      "p_rf",
      "p_xgb",
      "p_ann",
      "lapno",
      "race_progress",
      "position",
      "fcy_status",
      "pit_stops_so_far",
      "tyre_change_pursuer",
      "track_category",
      "current_compound",
      "lap_time",
      "interval",
      "tyre_age",
      "close_ahead",
      "race_track",
      "rained_yet",
      "is_raining",
      "minutes_rain",
      "fulfilled_second_compound",
      "row_id",
      "tcn_proba",
      "tcn_effective_len"
    ],
    "tcn": {
      "enabled": true,
      "seq_len": 8,
      "pad_left": true,
      "add_timestep_mask": true,
      "pad_value": -1.0,
      "effective_len_scaled_by": 8,
      "artifacts": {
        "preprocessor": "tcn_preprocessor.joblib",
        "model": "tcn_model.keras"
      }
    },
    "artifacts": {
      "meta_pipeline": "meta_pipeline.joblib",
      "meta_features": "meta_features.json",
      "feature_columns": "feature_columns.json",
      "base_pipelines": {
        "svm": "base_svm_pipeline.joblib",
        "rf": "base_rf_pipeline.joblib",
        "xgb": "base_xgb_pipeline.joblib",
        "ann": {
          "kind": "keras",
          "preprocessor": "ann_preprocessor.joblib",
          "model": "ann_model.keras",
          "spec": "ann_spec.json"
        }
      }
    }
  },
  "stage2_multiclass": {
    "stage": "stage2_multiclass",
    "n_classes": 5,
    "base_models": [
      "svm",
      "rf",
      "xgb",
      "ann",
      "vse_compound_ann"
    ],
    "meta_model": "xgb",
    "X_columns": [
      "race_progress",
      "pit_stops_so_far",
      "current_compound",
      "race_track",
      "fulfilled_second_compound",
      "rained_yet",
      "is_raining",
      "minutes_rain",
      "row_id"
    ],
    "meta_feature_columns": [
      "p_svm_c0",
      "p_svm_c1",
      "p_svm_c2",
